<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.example.oraclehbmspringbootpoc.model">
    <class name="DimCustomer" table="DIM_CUSTOMER">
        <id name="customerId" column="CUSTOMER_ID" type="long">
            <generator class="assigned"/>
        </id>
        <property name="customerName" column="CUSTOMER_NAME" type="string"/>
        <property name="email" column="EMAIL" type="string"/>
    </class>
</hibernate-mapping>
