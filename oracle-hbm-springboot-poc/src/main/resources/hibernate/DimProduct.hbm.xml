<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.example.oraclehbmspringbootpoc.model">
    <class name="DimProduct" table="DIM_PRODUCT">
        <id name="productId" column="PRODUCT_ID" type="long">
            <generator class="assigned"/>
        </id>
        <property name="productName" column="PRODUCT_NAME" type="string"/>
        <property name="category" column="CATEGORY" type="string"/>
    </class>
</hibernate-mapping>
