        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/1001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "1001"]
            }
          }
        }
      ]
    },
    {
      "name": "Order Lines",
