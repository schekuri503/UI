{
  "info": {
    "name": "oracle-hbm-springboot-poc",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get top customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Get customer by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "1"]
            }
          }
        }
      ]
    },
    {
